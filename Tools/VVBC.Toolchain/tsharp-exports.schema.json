{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VVBC T# raw export manifest v1",
  "type": "object",
  "required": ["schemaVersion", "versions", "unityContext", "productionRoots", "configurationInputs", "fixtureFiles", "programs", "managedOutputs"],
  "properties": {
    "schemaVersion": {"const": 1},
    "versions": {"type": "object", "required": ["unity", "worlds", "tsukimi"], "additionalProperties": {"type": "string"}},
    "unityContext": {"type": "string"},
    "productionRoots": {"type": "array", "items": {"type": "string"}},
    "configurationInputs": {"type": "array", "items": {"type": "string"}},
    "fixtureFiles": {"type": "array", "items": {"type": "object", "required": ["canonical", "staged"], "properties": {"canonical": {"type": "string"}, "staged": {"type": "string"}}}},
    "programs": {"type": "array", "items": {"$ref": "#/$defs/program"}},
    "managedOutputs": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
  },
  "$defs": {
    "program": {
      "type": "object",
      "required": ["id", "scope", "module", "programAsset", "unityProgramAsset", "unitySource", "productionInputs", "outputs", "inputFingerprint"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "scope": {"enum": ["package", "fixture"]},
        "module": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"},
        "programAsset": {"type": "string"},
        "unityProgramAsset": {"type": "string"},
        "unitySource": {"type": "string"},
        "productionInputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/output"}},
        "inputFingerprint": {"type": "string", "pattern": "^([a-f0-9]{64})?$"}
      }
    },
    "output": {
      "type": "object", "required": ["exportName", "path", "kind"],
      "properties": {
        "exportName": {"type": "string"}, "path": {"type": "string"},
        "kind": {"enum": ["programEntry", "supportSource"]}, "typeName": {"type": "string"}
      },
      "allOf": [{"if": {"properties": {"kind": {"const": "programEntry"}}}, "then": {"required": ["typeName"]}}]
    }
  }
}
