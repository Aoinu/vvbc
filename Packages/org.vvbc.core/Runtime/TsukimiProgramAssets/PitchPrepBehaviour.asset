  fieldLabels:
  - symbol: mound
    header: 
    tooltip: The mound this prepared data belongs to.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: judge
    header: 
    tooltip: 'Optional: the judge of the mound''s HomePlate. When empty it is the
      one registered on that HomePlate''s Ball.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: prepLifetimeSeconds
    header: 
    tooltip: Seconds a publication stays valid for receivers; the pitcher republishes
      before it ends. Guards against data left by a pitcher who stopped without withdrawing
      it. Default 600.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: verdictTimeoutSeconds
    header: 
    tooltip: Seconds after a pitch prepared for a batter until the pitcher checks
      that it was judged. Default 3.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: diagnostics
    header: 
    tooltip: Logs every publication, send and reception with the prefix PitchPrep[diag].
      Off in normal play.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
