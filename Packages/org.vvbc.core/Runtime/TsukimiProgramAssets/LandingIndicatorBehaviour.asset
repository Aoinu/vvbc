  fieldLabels:
  - symbol: zone
    header: References (wired inside the HomePlate prefab)
    tooltip: The HomePlate whose Ball this indicator follows.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: marker
    header: 
    tooltip: Horizontal Quad (1 x 1 in local XY) drawn with the landing marker material.
      No collider.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: groundReference
    header: 
    tooltip: Its world height is the ground plane. When empty, Ground Y is used.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: landingIndicatorEnabled
    header: Landing Indicator
    tooltip: Show the indicator at all. Future perks switch it with SetLandingIndicatorEnabled.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: predictionInterval
    header: 
    tooltip: Seconds between two predictions of the landing point.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: positionTransitionDuration
    header: 
    tooltip: Seconds the centre takes to move to a new prediction.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: groundY
    header: 
    tooltip: World height of the ground plane when no Ground Reference is set, in
      metres.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: groundOffset
    header: 
    tooltip: Height of the marker above the ground plane, in metres (against Z-fighting).
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: minRadius
    header: 
    tooltip: Circle radius with the ball on the ground, in metres.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxRadius
    header: 
    tooltip: Circle radius with the ball at Max Height or higher, in metres.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxHeight
    header: 
    tooltip: Ball centre height above the ground at which the radius reaches Max
      Radius, in metres.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxPredictionTime
    header: 
    tooltip: Flight time a prediction looks ahead at most, in seconds; no landing
      within it hides the marker.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: markerColor
    header: 
    tooltip: Marker colour (its alpha scales both alphas below).
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: outlineAlpha
    header: 
    tooltip: Alpha of the circle's outline.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0
    rangeMax: 1
  - symbol: interiorAlpha
    header: 
    tooltip: Alpha of the circle's interior.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0
    rangeMax: 1
  - symbol: outlineWidth
    header: 
    tooltip: Width of the circle's outline, in metres.
    hidden: 0
