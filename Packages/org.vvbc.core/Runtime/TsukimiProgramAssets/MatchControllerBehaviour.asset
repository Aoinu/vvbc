  fieldLabels:
  - symbol: roster
    header: References
    tooltip: The scene's RosterManager. Its liveLockAuthority must be this MatchManager
      object.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: operatorAuthority
    header: 
    tooltip: Decides who is the umpire (ProductionMatchOperatorAuthorityBehaviour
      on this object). Unset = nobody.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: ballQuery
    header: 
    tooltip: Confirmed possession of the match ball (MatchBallQueryAdapter). Unset
      = general Time is never accepted.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: basePoints
    header: 
    tooltip: 1B, 2B and 3B, for the Time distance condition.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: changeListeners
    header: 
    tooltip: Behaviours that receive the _OnMatchChanged custom event. Panels also
      register themselves.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: regulationInnings
    header: Rules
    tooltip: Innings of a regulation game. Default 9.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 1
    rangeMax: 30
  - symbol: maxInnings
    header: 
    tooltip: Last inning played when tied (extra innings included). Default 12.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 1
    rangeMax: 30
  - symbol: allowTie
    header: 
    tooltip: A game tied after maxInnings ends as a tie. Off = the umpire decides
      (the game is flagged).
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: timeRunnerBaseDistance
    header: 
    tooltip: Horizontal distance from 1B/2B/3B within which every runner must be
      for a player's Time, in metres. Default 3.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: allowDevelopmentRulings
    header: Development
    tooltip: Lets the umpire enter automatic-umpire rulings (Ball, Strike, Out, ...)
      by hand. Sample and test scenes only; leave off in a published world.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: lockTimeoutSeconds
    header: Network
    tooltip: Seconds the Owner waits for the roster lock before live play is cancelled.
      Default 3.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maximumSerializationRetries
    header: 
    tooltip: Retries at serializationRetrySeconds after a failed send; later retries
      wait five times longer. Default 3.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0
    rangeMax: 10
  - symbol: serializationRetrySeconds
    header: 
    tooltip: Delay before resending after a failed serialization, in seconds. Default
      1.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: recoveryWindowSeconds
    header: 
    tooltip: Seconds a new Owner collects the match state from the other players
      before it decides. Default 1.5.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maximumRecoveryRounds
    header: 
    tooltip: Recovery rounds at recoveryWindowSeconds before the Owner asks at a
      slower pace. Default 3.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 1
    rangeMax: 10
