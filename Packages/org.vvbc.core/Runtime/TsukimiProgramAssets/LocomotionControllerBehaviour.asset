  declaredBehaviourSyncMode: 1
  fieldLabels:
  - symbol: maximumSpeed
    header: Motion model (provisional validation values)
    tooltip: Maximum horizontal speed, in m/s.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: acceleration
    header: 
    tooltip: "Acceleration toward the stick target, in m/s\xB2."
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: deceleration
    header: 
    tooltip: "Deceleration with the stick released or eased, in m/s\xB2."
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: reverseAcceleration
    header: 
    tooltip: "Rate while the stick opposes the current velocity, in m/s\xB2."
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: snapTurnDegrees
    header: Turning and re-seat (validation)
    tooltip: VR snap turn per right-stick flick, in degrees. 0 disables it.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: recenterDistance
    header: 
    tooltip: Re-seat when the head is this far (m, horizontal) from the Station.
      0 disables it.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: recenterYaw
    header: 
    tooltip: Re-seat facing the head when its yaw is this far (degrees) from the
      Station. 0 disables it.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: recenterCooldownFrames
    header: 
    tooltip: Frames after an entry before the next re-seat may start.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: station
    header: References
    tooltip: 
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: enterTimeoutFrames
    header: 
    tooltip: Frames to wait for OnStationEntered before giving the request up.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: measureDelayFrames
    header: 
    tooltip: Frames after an entry before the head offset is measured.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  inspectorFields:
  - maximumSpeed
  - acceleration
  - deceleration
  - reverseAcceleration
  - snapTurnDegrees
  - recenterDistance
  - recenterYaw
  - recenterCooldownFrames
  - station
  - objectSync
  - gameplayAnchor
  - enterTimeoutFrames
  - measureDelayFrames
  inspectorPaths:
