    0.5\n    .export allowedRight\n    allowedForward: %SystemSingle, 1\n    .export
    allowedForward\n    allowedBackward: %SystemSingle, 0.3\n    .export allowedBackward\n   
    turnSpeed: %SystemSingle, 90\n    .export turnSpeed\n    autoTurnSpeed: %SystemSingle,
