  fieldLabels:
  - symbol: strikeZone
    header: References
    tooltip: StrikeZoneBehaviour of the HomePlate this mound pitches to. Its ball
      is the ball pitched.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: aimSolver
    header: 
    tooltip: Aim solver used only by this mound.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: cursor
    header: 
    tooltip: Cursor root (a copy of the ThrowAim reticle); shown only to the local
      pitcher.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: cursorRenderer
    header: 
    tooltip: Reticle renderer under the cursor; coloured with a MaterialPropertyBlock.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: statusListener
    header: 
    tooltip: Optional UI notified with OnManualPitchChanged when the state or calibration
      changes.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: moundCenter
    header: 
    tooltip: Mound centre. Its horizontal position is the lateral origin of the fixed
      release point. When empty, the child named MoundCenter is used, else this object.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: releaseAnchor
    header: 
    tooltip: Release anchor. The calibrated release is stored relative to it (toward
      the plate, up, toward the arm side) and the release range is measured from
      it. When empty, the child named ReleaseAnchor is used. Without one, no course
      can be solved.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: releaseForwardMin
    header: Release point range (P0 and the release plate centred on it)
    tooltip: Nearest release toward the plate, in metres from ReleaseAnchor along
      the mound-to-plate direction (extension). Default 0.5.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: releaseForwardMax
    header: 
    tooltip: Farthest release toward the plate, in metres from ReleaseAnchor (extension).
      Default 2.3.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: releaseHeightMin
    header: 
    tooltip: Lowest release, in metres above MoundCenter (the ground). Default 0.1.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: releaseHeightMax
    header: 
    tooltip: Highest release, in metres above MoundCenter (the ground). Default 2.0.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: releaseSideMin
    header: 
    tooltip: 'Least distance toward the throwing arm''s side, in metres from ReleaseAnchor:
      the pitcher''s right for a right-hander, the left for a left-hander. Default
      0.1.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: releaseSideMax
    header: 
    tooltip: Greatest distance toward the throwing arm's side, in metres from ReleaseAnchor.
      Default 0.6.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: horizontalMin
    header: Course (front-edge plane of home plate, metres)
    tooltip: 
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: cursorSmoothingSeconds
    header: 
    tooltip: Time constant of the cursor smoothing, in seconds. 0 disables smoothing.
      Default 0.08.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: cursorSize
    header: 
    tooltip: World size of the cursor reticle, in metres. Default 0.12.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: cursorOffset
    header: 
    tooltip: Distance of the cursor in front of the plane, toward the pitcher, in
      metres. Default 0.02.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxPitchSpeedKmh
    header: 4-Seam
    tooltip: 'Highest release speed, in km/h: a pitch leaves at this times the arm-speed
      curve''s output. Default 140.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: armSpeedCurve
    header: 
    tooltip: Arm speed (x, m/s, the recognition's averaged sample) to normalized
      release speed (y, 0..1). The output is clamped to 0..1 and held at the end
      keys outside them. Without keys every pitch leaves at maxPitchSpeedKmh.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: solverSpeedRatio
    header: 
    tooltip: Speed the solver aims with, as a fraction of maxPitchSpeedKmh, taken
      when the course is locked. Never applied to the release itself. Default 0.97.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0
    rangeMax: 1
  - symbol: fourSeamSpinRpm
    header: 
    tooltip: Spin of a 4-Seam released in the calibrated pose, in rpm. Default 2500.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxFourSeamSpinRpm
    header: 
    tooltip: Upper limit of the 4-Seam spin, in rpm. Default 2800.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: spinLossAtBadPose
    header: 
    tooltip: Fraction of the spin lost at a fully failed pose. Default 0 (no pose
      penalty, for real-client verification); 0.5 was the earlier tuning.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0
    rangeMax: 1
  - symbol: wakeCoefficient
    header: 
    tooltip: Fixed seam-shifted wake coefficient, in 1/s (capped at 0.055). Default
      0.006.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: wakeClockDegrees
    header: 
    tooltip: 'Wake direction as a clock angle seen from behind the pitcher: 0 up,
      90 arm side. Default 90.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: wakeLossAtBadPose
    header: 
    tooltip: Fraction of the wake lost at a fully failed pose. Default 0 (no pose
      penalty); 1 was the earlier tuning.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0
    rangeMax: 1
  - symbol: goodPoseAngle
    header: Pose quality
    tooltip: Controller rotation error with full quality, in degrees. Default 12.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: badPoseAngle
    header: 
    tooltip: Controller rotation error with no quality left, in degrees. Default
      50.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: minArmSpeed
    header: Recognition (throwing controller)
    tooltip: Minimum throwing-controller speed, in m/s. Default 1.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: armSampleMaxGapSeconds
    header: 
    tooltip: Longest gap between two throwing-controller samples still joined into
      one motion, in seconds; a longer gap starts the motion and the trajectory again.
      Samples are never discarded for their speed. Default 0.1.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: releasePlateWidth
    header: Release plate (recognition; the pitch always leaves from P0)
    tooltip: Width of the release plate centred on P0, in metres. Default 0.5.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: releasePlateHeight
    header: 
    tooltip: Height of the release plate centred on P0, in metres. Default 0.5.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: autoReleaseFrames
    header: 
    tooltip: Frames after the throwing controller crosses the release plate before
      the ball is released automatically. A manual release up to and including that
      frame wins. Default 6.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxPredictionDistance
    header: 
    tooltip: Longest path, in metres, from the hand to the plate along its current
      motion for a release before the plate to be a pitch. Default 0.30.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: controlSettings
    header: Control score (local fallbacks when no Control Settings is found)
    tooltip: Synced control settings of this mound (penalty strength, early cap,
      maximum error). When empty, the child ManualPitchControlSettingsBehaviour is
      used, else the three values below.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: controlPenaltyStrength
    header: 
    tooltip: 'Strength of the random control error, 0..1. Default 0: every pitch
      leaves along the solved direction.'
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0
    rangeMax: 1
  - symbol: earlyTimingScoreCap
    header: 
    tooltip: Score cap of a release before the plate (early). Default 60.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0
    rangeMax: 100
  - symbol: maxControlErrorMeters
    header: 
    tooltip: Largest control error at score 0 (before the strength), in metres at
      the plate's front edge. Provisional default 0.40.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: armDirectionPenaltyPerDegree
    header: Control (control only; never speed, spin, axis or SSW)
    tooltip: Crossing miss per degree between the arm's motion and the direction
      from the release point to the target, in metres, toward where the arm moved.
      Independent of the controller rotation. Default 0 (no penalty).
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: solverAcceptMeters
    header: 
    tooltip: Best solver error still accepted when it did not converge, in metres.
      Default 0.10.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: showReleaseFeedback
    header: Release feedback (local)
    tooltip: Show the fixed release point marker and the release result. Default
      on.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: idealMarkerColor
    header: 
    tooltip: Colour of the release point marker.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: idealMarkerDiameter
    header: 
    tooltip: Diameter of the release point marker, in metres. Default 0.09.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: idealMarker
    header: 
    tooltip: 'Calibration preview: follows the throwing controller while calibrating;
      hidden otherwise.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: releasePlate
    header: 
    tooltip: Release plate display, centred on P0 and facing the plate (no collider).
      When empty, the child Feedback/ReleasePlate is used.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: releasePlateBoard
    header: 
    tooltip: Board under the release plate, scaled to the plate size. When empty,
      the child Board of releasePlate is used.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: crossingMarker
    header: 
    tooltip: Small sphere (0.01 m, no collider) on the actual or predicted crossing
      of the last release. When empty, the child Feedback/CrossingMarker is used.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: handTrail
    header: 
    tooltip: Throwing-controller path of the last release. When empty, the child
      Feedback/HandTrail is used.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: predictionLine
    header: 
    tooltip: Extrapolated path to the predicted crossing of an early release. When
      empty, the child Feedback/PredictionLine is used.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: crossingMarkerDiameter
    header: 
    tooltip: Diameter of the crossing marker, in metres. Default 0.01.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: handTrailSeconds
    header: 
    tooltip: Length of the hand trail before the release, in seconds (at most 32
      samples). Default 0.2.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: arrivalTimeoutSeconds
    header: 
    tooltip: Longest time the pitch is followed to measure where it crosses the plate
      plane, in seconds. Default 3.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
