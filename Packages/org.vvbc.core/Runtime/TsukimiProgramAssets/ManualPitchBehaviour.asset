  optBeforeUasm: ".data_start\n    __sf__X9zPitchType__Names: %SystemStringArray,
    null\n    __sf__X9zPitchType__ParameterCounts: %SystemInt32Array, null\n    __sf__X9zPitchType__ParameterNames:
