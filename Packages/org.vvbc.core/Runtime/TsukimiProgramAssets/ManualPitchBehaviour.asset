    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: wakeLossAtBadPose
    header: 
    tooltip: Fraction of the wake lost at a fully failed pose. Default 1.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0
    rangeMax: 1
  - symbol: goodPoseAngle
