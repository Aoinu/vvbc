    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: velocityWindowSeconds
    header: 
    tooltip: Window of the arm velocity, in seconds. Default 0.08.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: controlGainX
    header: Control
    tooltip: Total lateral miss per lateral release error (1 = only the natural offset).
      Default 1.5.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: controlGainY
    header: 
    tooltip: Total vertical miss per vertical release error (1 = only the natural
      offset). Default 1.5.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: solverAcceptMeters
    header: 
    tooltip: Best solver error still accepted when it did not converge, in metres.
      Default 0.10.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: showReleaseFeedback
    header: Release feedback (local)
    tooltip: Show the calibrated release marker, the release markers and the release
      result. Default on.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: idealMarker
    header: 
    tooltip: Live ideal release point (moves with the chest).
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: rangeMarker
    header: 
    tooltip: Recognition ellipsoid around the ideal release (a unit sphere scaled
      to the radii).
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: releaseIdealMarker
    header: 
    tooltip: Ideal release point at the last release.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: releaseActualMarker
    header: 
    tooltip: Actual release point (throwing controller) at the last release.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: releaseErrorLine
    header: 
    tooltip: Line from the ideal to the actual release point.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: arrivalTimeoutSeconds
    header: 
    tooltip: Longest time the pitch is followed to measure where it crosses the plate
      plane, in seconds. Default 3.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: releaseResultText
    header: 
    tooltip: 
    hidden: 1
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: showDebug
    header: Debug (local)
    tooltip: 
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: debugSeconds
    header: 
    tooltip: Seconds the release result stays on the debug label. Default 6.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: state
    header: 
    tooltip: 
    hidden: 1
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
