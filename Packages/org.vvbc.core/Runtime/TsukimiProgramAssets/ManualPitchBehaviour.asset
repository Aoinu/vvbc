  fieldLabels:
  - symbol: strikeZone
    header: References
    tooltip: StrikeZoneBehaviour of the HomePlate this mound pitches to. Its ball
      is the ball pitched.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: aimSolver
    header: 
    tooltip: Aim solver used only by this mound.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: cursor
    header: 
    tooltip: Cursor root (a copy of the ThrowAim reticle); shown only to the local
      pitcher.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: cursorRenderer
    header: 
    tooltip: Reticle renderer under the cursor; coloured with a MaterialPropertyBlock.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: statusListener
    header: 
    tooltip: Optional UI notified with OnManualPitchChanged when the state or calibration
      changes.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: horizontalMin
    header: Course (front-edge plane of home plate, metres)
    tooltip: 
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: cursorSmoothingSeconds
    header: 
    tooltip: Time constant of the cursor smoothing, in seconds. 0 disables smoothing.
      Default 0.08.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: cursorSize
    header: 
    tooltip: World size of the cursor reticle, in metres. Default 0.12.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: cursorOffset
    header: 
    tooltip: Distance of the cursor in front of the plane, toward the pitcher, in
      metres. Default 0.02.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: pitchSpeedKmh
    header: 4-Seam
    tooltip: Release speed, in km/h. Default 140.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: fourSeamSpinRpm
    header: 
    tooltip: Spin of a 4-Seam released in the calibrated pose, in rpm. Default 2500.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxFourSeamSpinRpm
    header: 
    tooltip: Upper limit of the 4-Seam spin, in rpm. Default 2800.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: spinLossAtBadPose
    header: 
    tooltip: Fraction of the spin lost at a fully failed pose. Default 0.5.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0
    rangeMax: 1
  - symbol: gyroAtBadPose
    header: 
    tooltip: Fraction of the spin axis turned into gyro spin at a fully failed pose.
      Default 0.5.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0
    rangeMax: 1
  - symbol: wakeCoefficient
    header: 
    tooltip: Fixed seam-shifted wake coefficient, in 1/s (capped at 0.055). Default
      0.006.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: wakeClockDegrees
    header: 
    tooltip: 'Wake direction as a clock angle seen from behind the pitcher: 0 up,
      90 arm side. Default 90.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: wakeLossAtBadPose
    header: 
    tooltip: Fraction of the wake lost at a fully failed pose. Default 1.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0
    rangeMax: 1
  - symbol: goodPoseAngle
    header: Pose quality
    tooltip: Controller rotation error with full quality, in degrees. Default 12.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: badPoseAngle
    header: 
    tooltip: Controller rotation error with no quality left, in degrees. Default
      50.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: axisTransferGain
    header: 
    tooltip: Part of the pose error carried into the spin axis. Default 0.5.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0
    rangeMax: 1
  - symbol: recognitionRadii
    header: Recognition
    tooltip: Radii of the recognition ellipsoid around the calibrated release (right,
      up, forward), in metres.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: minArmSpeed
    header: 
    tooltip: Minimum arm speed, in m/s. Default 1.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxDirectionErrorDegrees
    header: 
    tooltip: Largest angle between the arm motion and the plate direction, in degrees.
      Default 60.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: velocityWindowSeconds
    header: 
    tooltip: Window of the arm velocity, in seconds. Default 0.08.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: controlGainX
    header: Control
    tooltip: 'Total lateral miss per lateral controller release error, approximately:
      0 cancels the miss the offset makes by itself, 0.5 halves it, 1 adds nothing,
      1.5 amplifies it. Spin and wake changes are not compensated. Default 0.5.'
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0
    rangeMax: 2
  - symbol: controlGainY
    header: 
    tooltip: Total vertical miss per vertical controller release error, approximately
      (see controlGainX). Default 0.5.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0
    rangeMax: 2
  - symbol: solverAcceptMeters
    header: 
    tooltip: Best solver error still accepted when it did not converge, in metres.
      Default 0.10.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: showReleaseFeedback
    header: Release feedback (local)
    tooltip: Show the calibrated release marker, the release markers and the release
      result. Default on.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: showRecognitionRange
    header: 
    tooltip: 'Also show the recognition ellipsoid (recognitionRadii) around the ideal
      release. Display only: recognition is the same either way. Default off.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: idealMarkerColor
    header: 
    tooltip: Colour of the ideal release markers (live and at the last release).
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: actualMarkerColor
    header: 
    tooltip: Colour of the actual release marker (throwing controller).
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: errorLineColor
    header: 
    tooltip: Colour of the line from the ideal to the actual release.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: idealMarkerDiameter
    header: 
    tooltip: Diameter of the live ideal release marker, in metres. Default 0.09.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: releaseMarkerDiameter
    header: 
    tooltip: Diameter of the last release's markers, in metres. Default 0.07.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: errorLineWidth
    header: 
    tooltip: Width of the release error line, in metres. Default 0.012.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: idealMarker
    header: 
    tooltip: Live ideal release point (moves with the chest).
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: rangeMarker
    header: 
    tooltip: Recognition ellipsoid around the ideal release (a unit sphere scaled
      to the radii).
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: releaseIdealMarker
    header: 
    tooltip: Ideal release point at the last release.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: releaseActualMarker
    header: 
    tooltip: Actual release point (throwing controller) at the last release.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: releaseErrorLine
    header: 
    tooltip: Line from the ideal to the actual release point.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: arrivalTimeoutSeconds
    header: 
    tooltip: Longest time the pitch is followed to measure where it crosses the plate
      plane, in seconds. Default 3.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
