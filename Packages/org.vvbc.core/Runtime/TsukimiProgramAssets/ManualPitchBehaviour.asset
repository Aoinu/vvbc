  - symbol: arrivalCrossing
    header: 
    tooltip: 
    hidden: 1
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: statusText
    header: 
    tooltip: 
    hidden: 1
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: pitchSelectDeadZone
    header: Pitch type selection (local; right stick up and down)
    tooltip: Stick deflection (InputLookVertical, 0..1) that switches the type once.
      Default 0.5.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: pitchSelectNeutral
    header: 
    tooltip: Stick deflection the stick must come back within before the next switch.
      Default 0.2.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: invertPitchSelect
    header: 
    tooltip: 'Off: up selects the previous type, down the next. On: the other way
      (if a client reports the stick inverted).'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: showPitchTypeLabel
    header: 
    tooltip: Show the selected type's name above the release plate (local). Default
      on.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: pitchTypeLabel
    header: 
    tooltip: Text above the release plate. When empty, the child Feedback/PitchTypeLabel
      is used.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: pitchTypeLabelFontSize
    header: 
    tooltip: Font size of the type label (TextMeshPro). Default 1.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: pitchTypeLabelOffset
    header: 
    tooltip: Gap between the plate's top edge and the label, in metres. Default 0.06.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: poseEvaluation
    header: 'Pitch quality (each array is indexed by PitchType id: 0 4-Seam, 1 2-Seam,
      2 Sinker, 3 Cutter, 4 Slider, 5 Sweeper, 6 Curve, 7 Split, 8 Change, 9 Knuckle)'
    tooltip: 'Whether the type''s palm direction is evaluated, by PitchType id. Off:
      pose quality 1. Default: off for the 4-Seam, on for the others.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: idealPalmDirections
    header: 
    tooltip: 'Ideal palm normal at the release, by PitchType id, for a right-hander
      throwing straight overhand (pitching frame: x the pitcher''s right, y up, z
      toward the plate). Turned by the arm slot and mirrored for a left-hander. An
      entry missing here (or zero) uses the provisional default.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: poseGoodAngles
    header: 
    tooltip: Palm error with full quality, in degrees, by PitchType id. Provisional.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: poseBadAngles
    header: 
    tooltip: Palm error with no quality left (the common failure mode), in degrees,
      by PitchType id. Provisional.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: referenceSlotAngle
    header: 
    tooltip: Arm slot the ideal palms are written for, in degrees (0 straight up,
      90 to the side). The ideal palm turns by the calibrated slot minus this. Default
      0.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: rightPalmLocal
    header: 
    tooltip: 'Palm normal in the right controller''s tracking rotation (VRChat RightHand
      tracking data). Provisional: check on each headset.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: leftPalmLocal
    header: 
    tooltip: 'Palm normal in the left controller''s tracking rotation (VRChat LeftHand
      tracking data). Provisional: check on each headset.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: qualityTimingCap
    header: 
    tooltip: Quality cap of a release outside the ideal timing (early, late), every
      type. Independent of the control timing cap. Provisional default 0.6.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0
    rangeMax: 1
  - symbol: failureSpinRatio
    header: 
    tooltip: Spin of the common failure mode, as a fraction of the 4-Seam rpm (fourSeamSpinRpm).
      Default 0.7.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0
    rangeMax: 1
