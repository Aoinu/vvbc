    rangeMin: 0
    rangeMax: 1
  - symbol: maximumVolume
    header: 
    tooltip: Volume at maximum speed.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0
    rangeMax: 1
  - symbol: pitch
    header: 
    tooltip: Impact playback pitch.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0.1
    rangeMax: 3
  - symbol: cooldown
    header: 
    tooltip: Minimum time between impacts, in seconds.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: windClip
    header: Wind Audio
    tooltip: Flight wind clip. Playback is one-shot until reset.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: windStartSpeed
    header: 
    tooltip: Speed where wind begins, in metres per second.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: windMaxSpeed
    header: 
    tooltip: Speed where wind reaches maximum volume, in metres per second.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: windMaxVolume
    header: 
    tooltip: Maximum wind AudioSource volume.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0
    rangeMax: 1
  - symbol: sampledPosition
    header: 
    tooltip: 
    hidden: 1
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: sampledVelocity
    header: 
    tooltip: 
    hidden: 1
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: sampledAngularVelocity
    header: 
    tooltip: 
    hidden: 1
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: sampledRotation
    header: 
    tooltip: 
    hidden: 1
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: oldestMotionTime
    header: 
    tooltip: 
    hidden: 1
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: latestMotionTime
    header: 
    tooltip: 
    hidden: 1
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: contactListener
    header: 
    tooltip: 
    hidden: 1
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maximumCatchupSeconds
    header: Network
    tooltip: Maximum age of a received flight snapshot to simulate, in seconds. Default
      3.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: minimumCatchupStep
    header: 
    tooltip: Smallest fixed timestep allowed for network catch-up, in seconds. Default
      0.005.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maximumSerializationRetries
    header: 
    tooltip: Maximum retries after a failed serialization. Default 3.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0
    rangeMax: 10
  - symbol: serializationRetrySeconds
    header: 
    tooltip: Delay between serialization retries, in seconds. Default 1.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: ownershipCheckSeconds
    header: 
    tooltip: Delay before checking a pending ownership transfer, in seconds. Default
      1.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: minimumTrailSpeedKmh
    header: Visual Effects
    tooltip: Minimum speed for the trail, in km/h.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: minimumPathPointDistance
    header: 
    tooltip: Minimum distance between world-space path points, in metres.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maximumPathPoints
    header: 
    tooltip: Maximum number of points retained until reset.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
