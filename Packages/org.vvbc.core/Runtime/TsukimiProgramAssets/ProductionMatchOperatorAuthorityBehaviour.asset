  fieldLabels:
  - symbol: recoveryWindowSeconds
    header: 
    tooltip: Seconds a new Owner collects the umpire state from the other players
      before it decides. Default 1.5.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maximumRecoveryRounds
    header: 
    tooltip: Recovery rounds at recoveryWindowSeconds before the Owner asks at a
      slower pace. Default 3.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 1
    rangeMax: 10
  - symbol: leaveCheckSeconds
    header: 
    tooltip: Delay after a player leaves before the Owner checks that the umpire
      is still here, in seconds. Default 1.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: serializationRetrySeconds
    header: 
    tooltip: Delay before resending after a failed serialization, in seconds. Default
      1.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
