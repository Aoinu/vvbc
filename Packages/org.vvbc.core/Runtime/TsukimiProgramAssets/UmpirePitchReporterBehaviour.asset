    tooltip: 
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: strikeZone
    header: 
    tooltip: 'The HomePlate''s strike zone: its plate gives the direction toward
