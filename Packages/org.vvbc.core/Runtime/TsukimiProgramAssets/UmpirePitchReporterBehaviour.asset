    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: swingWindowBeforeSeconds
    header: Swing recognition
    tooltip: Seconds before the plate crossing the swing window starts. Default 0.25.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: swingWindowAfterSeconds
    header: 
    tooltip: Seconds after the crossing the window ends (the report waits for it).
      Default 0.12.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: swingMinSpeed
    header: 
    tooltip: Lowest peak sweet-spot speed of a swing, in m/s. Default 9.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: swingMinAngularSpeed
    header: 
    tooltip: Lowest peak bat angular speed of a swing, in degrees per second. Default
      360.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: swingMinSweepDegrees
    header: 
    tooltip: Lowest turn of the bat's horizontal direction within the window, in
      degrees. Default 45.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: swingRequireForward
    header: 
    tooltip: Require the sweet spot to come toward the pitcher within the window.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: swingMinForward
    header: 
    tooltip: Lowest forward motion of the sweet spot toward the pitcher, in metres.
      Default 0.1.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: bouncePlateTimeoutSeconds
    header: 
    tooltip: A pitch that bounced before the zone is reported this long after the
      bounce at the latest, when it never passes the plate. Default 1.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
