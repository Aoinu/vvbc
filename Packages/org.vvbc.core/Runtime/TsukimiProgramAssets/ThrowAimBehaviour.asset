  fieldLabels:
  - symbol: baseTargets
    header: Targets (one entry per index)
    tooltip: 'Target Transform per target: the point a throw is aimed at, placed
      at receiving height. Any number of targets (bases, relay points). An empty
      entry is skipped.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: targetNames
    header: 
    tooltip: 'Display name per target, written to its Label and used by the release
      feedback. Missing or empty: the target Transform''s name.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: markers
    header: 
    tooltip: 'Marker Root per target (with Reticle and Label children): positioned,
      turned toward the player and shown or hidden by ThrowAim.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: reticleRenderers
    header: 
    tooltip: Reticle MeshRenderer per target (a quad with the shared reticle material).
      Its colour comes from Marker Colors.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: labelTexts
    header: 
    tooltip: Label TextMeshPro per target; its text is set to the target name once.
      Its own colour is kept.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: markerColors
    header: 
    tooltip: 'Reticle colour per target, applied once with a MaterialPropertyBlock
      (the material is shared). Missing: white.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: minDistances
    header: 
    tooltip: 'Shortest horizontal (XZ) distance from the thrower at which the target
      is shown and selectable, in metres. 0 or missing: no minimum.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxDistances
    header: 
    tooltip: 'Longest horizontal (XZ) distance from the thrower at which the target
      is shown and selectable, in metres. 0 or missing: no maximum. Must not be below
      the minimum when both are set.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: targetEnabled
    header: 
    tooltip: 'Whether each target is used at all. Missing: enabled.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: aimDistance
    header: Aim Markers
    tooltip: Distance of the markers from the thrower's eye point, in metres. Default
      1.5.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxAimElevation
    header: 
    tooltip: Largest marker elevation, in degrees. Default 30.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: aimElevationGain
    header: 
    tooltip: Multiplier on the no-drag elevation at the reference speed. Default
      1.5.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: referenceSpeedKmh
    header: 
    tooltip: Reference speed for the marker elevation, in km/h. Default 110.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: minThrowSpeedKmh
    header: Throw Speed
    tooltip: Throw speed at or below the slow arm speed, in km/h. Default 90.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxThrowSpeedKmh
    header: 
    tooltip: Throw speed at or above the fast arm speed, in km/h. Default 145.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: slowArmSpeed
    header: 
    tooltip: Arm speed giving the minimum throw speed, in m/s. Default 2.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: fastArmSpeed
    header: 
    tooltip: Arm speed giving the maximum throw speed, in m/s. Default 10.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxLaunchElevation
    header: Trajectory
    tooltip: Largest launch elevation (and depression), in degrees. Default 12.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: throwSpinRpm
    header: 
    tooltip: Backspin of a throw, in rpm. Default 1500.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: perfectAimRadius
    header: Control
    tooltip: Arm-ray miss at or below which the smallest error applies, in metres.
      Default 0.15.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: wildAimRadius
    header: 
    tooltip: Arm-ray miss at or above which the largest error applies, in metres.
      Default 1.0.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: minErrorDegrees
    header: 
    tooltip: Smallest error cone, in degrees. Default 0 (no random error).
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxErrorDegrees
    header: 
    tooltip: Largest error cone, in degrees. Default 0 (no random error); 8 was the
      earlier tuning.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: velocityWindowSeconds
    header: Arm Tracking
    tooltip: Newest span of hand samples used for the arm velocity, in seconds. Default
      0.08.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxTrackingSpeed
    header: 
    tooltip: Sample-to-sample speed treated as a tracking jump and discarded, in
      m/s. Default 40.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: minDirectionSpeed
    header: 
    tooltip: Below this arm speed the aim ray uses the head direction, in m/s. Default
      1.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: showReleaseFeedback
    header: Release Feedback (debug, local only)
    tooltip: After each release, show the input aim point, the selected target, the
      final launch direction and the solver result. Local, not synced. Default off.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: releaseFeedbackSeconds
    header: 
    tooltip: How long the release feedback stays visible, in seconds. Default 3.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: aimPointMarker
    header: 
    tooltip: Marker placed where the arm (input) ray crossed the marker sphere. Inactive
      until shown.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: launchDirectionMarker
    header: 
    tooltip: Marker placed where the final launch direction crosses the marker sphere.
      Inactive until shown.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: selectedHighlight
    header: 
    tooltip: Highlight placed on the selected target's marker. Inactive until shown.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: feedbackLabel
    header: 
    tooltip: Text naming the selected target and the aim errors.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: feedbackLabelRoot
    header: 
    tooltip: Transform moved next to the feedback and turned toward the player (the
      label's world-space canvas).
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
