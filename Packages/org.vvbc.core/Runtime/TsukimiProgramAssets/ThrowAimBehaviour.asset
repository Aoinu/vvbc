  generatedGpuAssets: []
  gpuLoadSourceFields: []
  generatedGpuMaterials: []
  declaredBehaviourSyncMode: 1
  fieldLabels:
  - symbol: targets
    header: Targets
    tooltip: 'Throw targets: one TargetBehaviour per target (on the target''s own
      object, for example Targets/FirstBase), holding its point, marker and selection
      settings. Any number (bases, relay points). An empty entry is skipped. Read
      once, at the first hold.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: aimDistance
    header: Aim Markers
    tooltip: Distance of the markers from the thrower's eye point, in metres. Default
      1.5.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxAimElevation
    header: 
    tooltip: Largest marker elevation, in degrees. Default 30.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: aimElevationGain
    header: 
    tooltip: Multiplier on the no-drag elevation at the reference speed. Default
      1.5.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: referenceSpeedKmh
    header: 
    tooltip: Reference speed for the marker elevation, in km/h. Default 110.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: minThrowSpeedKmh
    header: Throw Speed
    tooltip: Throw speed at or below the slow arm speed, in km/h. Default 90.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxThrowSpeedKmh
    header: 
    tooltip: Throw speed at or above the fast arm speed, in km/h, in a world without
      the player perk system (with it, the thrower's Ball Speed perk). Default 120,
      the perk standard.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: slowArmSpeed
    header: 
    tooltip: Arm speed giving the minimum throw speed, in m/s. Default 2.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: fastArmSpeed
    header: 
    tooltip: Arm speed giving the maximum throw speed, in m/s. Default 10.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxLaunchElevation
    header: Trajectory
    tooltip: Largest launch elevation (and depression), in degrees. Default 12.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: throwSpinRpm
    header: 
    tooltip: Backspin of a throw, in rpm. Default 1500.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: perfectAimRadius
    header: Control
    tooltip: Arm-ray miss at or below which the smallest error applies, in metres.
      Default 0.15.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: wildAimRadius
    header: 
    tooltip: Arm-ray miss at or above which the largest error applies, in metres.
      Default 1.0.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: minErrorDegrees
    header: 
    tooltip: Smallest error cone, in degrees. Default 0 (no random error).
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxErrorDegrees
    header: 
    tooltip: Largest error cone, in degrees. Default 0 (no random error); 8 was the
      earlier tuning.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxSampleGapSeconds
    header: Arm Tracking (throwing controller)
    tooltip: Longest gap between two throwing-controller samples still joined into
      one motion, in seconds; a longer gap starts the motion again. Samples are never
      discarded for their speed. Default 0.1.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: minDirectionSpeed
    header: 
    tooltip: Below this arm speed the aim ray uses the head direction, in m/s. Default
      1.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: showReleaseFeedback
    header: Release Feedback (debug, local only)
    tooltip: After each release, show the input aim point, the selected target, the
      final launch direction and the solver result. Local, not synced. Default off.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: releaseFeedbackSeconds
    header: 
    tooltip: How long the release feedback stays visible, in seconds. Default 3.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: aimPointMarker
    header: 
    tooltip: Marker placed where the arm (input) ray crossed the marker sphere. Inactive
      until shown.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: launchDirectionMarker
    header: 
    tooltip: Marker placed where the final launch direction crosses the marker sphere.
      Inactive until shown.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: selectedHighlight
    header: 
    tooltip: Highlight placed on the selected target's marker. Inactive until shown.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: feedbackLabel
    header: 
    tooltip: Text naming the selected target and the aim errors.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: feedbackLabelRoot
    header: 
    tooltip: Transform moved next to the feedback and turned toward the player (the
      label's world-space canvas).
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: selectedTarget
