  fieldLabels:
  - symbol: baseTargets
    header: Targets
    tooltip: 'Throw targets in order: first base, second base, third base, home plate.
      Place each at receiving height.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: markers
    header: 
    tooltip: Marker for each target, shown near the thrower while the ball is held.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: aimDistance
    header: Aim Markers
    tooltip: Distance of the markers from the thrower's eye point, in metres. Default
      1.5.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxAimElevation
    header: 
    tooltip: Largest marker elevation, in degrees. Default 30.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: aimElevationGain
    header: 
    tooltip: Multiplier on the no-drag elevation at the reference speed. Default
      1.5.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: referenceSpeedKmh
    header: 
    tooltip: Reference speed for the marker elevation, in km/h. Default 110.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: minThrowSpeedKmh
    header: Throw Speed
    tooltip: Throw speed at or below the slow arm speed, in km/h. Default 90.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxThrowSpeedKmh
    header: 
    tooltip: Throw speed at or above the fast arm speed, in km/h. Default 145.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: slowArmSpeed
    header: 
    tooltip: Arm speed giving the minimum throw speed, in m/s. Default 2.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: fastArmSpeed
    header: 
    tooltip: Arm speed giving the maximum throw speed, in m/s. Default 10.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxLaunchElevation
    header: Trajectory
    tooltip: Largest launch elevation (and depression), in degrees. Default 12.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: throwSpinRpm
    header: 
    tooltip: Backspin of a throw, in rpm. Default 1500.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: perfectAimRadius
    header: Control
    tooltip: Arm-ray miss at or below which the smallest error applies, in metres.
      Default 0.15.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: wildAimRadius
    header: 
    tooltip: Arm-ray miss at or above which the largest error applies, in metres.
      Default 1.0.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: minErrorDegrees
    header: 
    tooltip: Smallest error cone, in degrees. Default 0.5.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxErrorDegrees
    header: 
    tooltip: Largest error cone, in degrees. Default 8.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: velocityWindowSeconds
    header: Arm Tracking
    tooltip: Newest span of hand samples used for the arm velocity, in seconds. Default
      0.08.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxTrackingSpeed
    header: 
    tooltip: Sample-to-sample speed treated as a tracking jump and discarded, in
      m/s. Default 40.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: minDirectionSpeed
    header: 
    tooltip: Below this arm speed the aim ray uses the head direction, in m/s. Default
      1.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: showReleaseFeedback
    header: Release Feedback (debug, local only)
    tooltip: After each release, show the selected target, where the arm ray crossed
      the marker sphere and the aim errors. Local, not synced. Default off.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: releaseFeedbackSeconds
    header: 
    tooltip: How long the release feedback stays visible, in seconds. Default 3.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: aimPointMarker
    header: 
    tooltip: Marker placed where the arm ray crossed the marker sphere. Inactive
      until shown.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: selectedHighlight
    header: 
    tooltip: Highlight placed on the selected target's marker. Inactive until shown.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: feedbackLabel
    header: 
