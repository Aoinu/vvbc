  fieldLabels:
  - symbol: strikeZone
    header: 
    tooltip: 'The strike zone on this GameObject: its occupant is the judging batter.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: delaySetting
    header: 
    tooltip: The shared delay threshold setting.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: fallbackThresholdMs
    header: 
    tooltip: Allowed delay without a delay setting, in ms (a LocalRig or a scene
      without the setting). Default 100.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: messageLabel
    header: 
    tooltip: Optional text near the plate that shows an invalid or cancelled pitch
      to everyone.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: messageSeconds
    header: 
    tooltip: Seconds a verdict message stays shown; a late joiner sees it only within
      this time. Default 8.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: captureRadius
    header: Release detection (remote pitcher's throwing hand)
    tooltip: Largest distance of the remote hand from the ideal release at its closest
      pass, in metres. Remote hands are avatar bones, not controllers, so this is
      generous. Default 0.7.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: minHandSpeed
    header: 
    tooltip: Smallest hand speed toward the target at the pass, in m/s. Default 2.5.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxHandAngleDegrees
    header: 
    tooltip: Largest angle between the hand's motion and the pitch direction at the
      pass, in degrees. Default 75.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxSampleGapSeconds
    header: 
    tooltip: A longer gap between two hand samples starts the motion again, in seconds.
      Default 0.1.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: motionWaitSeconds
    header: 
    tooltip: How long a HandPitch waits for the release motion to arrive, independently
      of the delay limit. Default 1 second.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: candidateMatchSeconds
    header: 
    tooltip: Maximum age of hand samples used to verify an earlier preparation geometry.
      Default 1.5 seconds.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: diagnostics
    header: 
    tooltip: Logs detection, arrival, delay, speculation and every verdict with the
      prefix PitchJudge[diag]. rt= is this client's Time.realtimeSinceStartup, server=
      the server time. Off in normal play.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: phase
    header: 
    tooltip: 
    hidden: 1
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: monitoring
    header: 
    tooltip: 
    hidden: 1
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
