  fieldLabels:
  - symbol: maximumSpeed
    header: "Speed control (m/s, m/s\xB2)"
    tooltip: 
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: acceleration
    header: 
    tooltip: "Acceleration at rest (m/s\xB2). It falls linearly with speed and reaches
      zero at the maximum: a(v) = a0 (1 - v / max)."
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: deceleration
    header: 
    tooltip: "Rate (m/s\xB2) at which inertia slows down or turns. Independent of
      the maximum speed."
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: inputDeadzone
    header: 
    tooltip: 
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0
    rangeMax: 1
  - symbol: walkSpeedRatio
    header: 
    tooltip: 
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0.01
    rangeMax: 0.99
  - symbol: directionMinimumSpeed
    header: 
    tooltip: Below this speed (m/s) a velocity has no direction for turn braking.
      Keep it under Minimum Applied Speed so braking does not toggle at the floor.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: speedMultiplier
    header: Modifiers (abilities, buffs and debuffs)
    tooltip: Multiplies Maximum Speed.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: accelerationMultiplier
    header: 
    tooltip: Multiplies Acceleration (at rest). Deceleration is not affected.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: speedLimitEnabled
    header: Validation
    tooltip: 
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: logInterval
    header: 
    tooltip: Seconds between periodic log lines while moving. 0 logs only events.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
