  declaredBehaviourSyncMode: 1
  fieldLabels:
  - symbol: maximumSpeed
    header: "Speed control (m/s, m/s\xB2)"
    tooltip: 
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: acceleration
    header: 
    tooltip: "Acceleration at rest (m/s\xB2). It falls linearly with speed and reaches
      zero at the maximum: a(v) = a0 (1 - v / max). With the 3 m/s initial speed,
      6.24 covers home to first base in 4.2 s (docs/development/player-perks.md)."
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: deceleration
    header: 
    tooltip: "Rate (m/s\xB2) at which inertia slows down or turns. Independent of
      the maximum speed."
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: initialSpeed
    header: 
    tooltip: Run/Strafe speed (m/s) given at once when the stick leaves the deadzone
      from rest. Not scaled by Speed Multiplier; never above the maximum or the feedback
      limit, and never lowers the applied speed.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: restSpeedThreshold
    header: 
    tooltip: Initial Speed is given only while both the measured and the inertial
      speed are below this (m/s).
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: inputDeadzone
    header: 
    tooltip: 
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0
    rangeMax: 1
  - symbol: walkSpeedRatio
    header: 
    tooltip: 
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0.01
    rangeMax: 0.99
  - symbol: turnBrakingStrength
    header: 
    tooltip: "Turn braking B_turn = strength x |inertia| x (1 - cos angle): |inertia|
      at 90\xB0, twice it at 180\xB0. 0 disables it."
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: directionMinimumSpeed
    header: 
    tooltip: Below this speed (m/s) a velocity has no direction for turn braking.
      Keep it under Minimum Applied Speed so braking does not toggle at the floor.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: speedMultiplier
    header: Modifiers (abilities, buffs and debuffs)
    tooltip: Multiplies Maximum Speed and the acceleration at rest together, so max
      / a0 (the shape of the speed curve) is kept. Initial Speed is not scaled.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: accelerationMultiplier
    header: 
    tooltip: Multiplies Acceleration (at rest). Deceleration is not affected.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: jumpCooldown
    header: Jump
    tooltip: Seconds after landing from a jump before the next jump is allowed. Jumping
      is also blocked while airborne.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: landingSpeedRatio
    header: 
    tooltip: On landing from a jump the applied Run/Strafe speed is cut once to at
      most this fraction of the maximum.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0
    rangeMax: 1
  - symbol: speedLimitEnabled
    header: Validation
    tooltip: 
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: logInterval
    header: 
    tooltip: Seconds between periodic log lines while moving. 0 logs only events.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
