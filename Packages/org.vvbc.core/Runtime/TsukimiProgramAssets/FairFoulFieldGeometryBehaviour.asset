    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: thirdBase
    header: 
    tooltip: 'Third base: the third-base foul line runs from home through it.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: ballRadius
    header: Ball
    tooltip: 'Ball radius in metres: a ball within it of a foul line touches the
