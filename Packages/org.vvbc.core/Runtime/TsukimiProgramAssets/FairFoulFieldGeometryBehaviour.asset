    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: foulPoleRadius
    header: 
    tooltip: Pole radius in metres. Default 0.15.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: foulPoleHeight
    header: 
    tooltip: Pole height above its base in metres. Default 20.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: outOfPlayDistance
