  fieldLabels:
  - symbol: targetPoint
    header: Target
    tooltip: 'The point a throw is aimed at, placed at receiving height. Empty: the
      target is skipped.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: displayName
    header: 
    tooltip: 'Name written to the Label and used by the release feedback. Empty:
      the Target Point''s name.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: marker
    header: Marker
    tooltip: 'Marker Root (with Reticle and Label children): positioned, turned toward
      the player and shown or hidden by ThrowAim. Empty: no marker is shown; the
      target is still selectable while in range.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: reticleRenderer
    header: 
    tooltip: Reticle MeshRenderer (a quad with the shared reticle material). Its
      colour comes from Marker Color.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: labelText
    header: 
    tooltip: Label TextMeshPro; its text is set to the display name once. Its own
      colour is kept.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: markerColor
    header: 
    tooltip: Reticle colour, applied once with a MaterialPropertyBlock (the material
      is shared). Default white.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: minDistance
    header: Selection
    tooltip: 'Shortest horizontal (XZ) distance from the thrower at which the target
      is shown and selectable, in metres. 0: no minimum.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxDistance
    header: 
    tooltip: 'Longest horizontal (XZ) distance from the thrower at which the target
      is shown and selectable, in metres. 0: no maximum. Must not be below the minimum
      when both are set.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: targetEnabled
    header: 
    tooltip: Whether the target is used at all, in or out of pitcher mode. Default
      on.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: allowDuringPitcherMode
    header: 
    tooltip: 'Whether the target may be shown and selected while the local player
      is in pitcher mode on a mound (pickoff throws to the bases). Off for HomePlate:
      a pitch that is not recognized must not become a throw home. Ignored outside
      pitcher mode. Default on.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
