  declaredBehaviourSyncMode: 4
  fieldLabels:
  - symbol: operatorAuthority
    header: 
    tooltip: Optional. Decides who may release other players and reorder any row.
      Unset = nobody.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: liveLockAuthority
    header: 
    tooltip: The MatchManager object. Only its Owner may lock the roster for live
      play and unlock it. Unset = the roster is never locked.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: changeListeners
    header: 
    tooltip: Behaviours that receive the _OnRosterChanged custom event. Panels also
      register themselves at Start.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maximumSerializationRetries
    header: Network
    tooltip: Retries at serializationRetrySeconds after a failed send; later retries
      wait five times longer. Default 3.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 0
    rangeMax: 10
  - symbol: serializationRetrySeconds
    header: 
    tooltip: Delay before resending after a failed serialization, in seconds. Default
      1.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: requestTimeoutSeconds
    header: 
    tooltip: Seconds a local request waits for the Owner's answer before its button
      is released again. Default 5.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: recoveryWindowSeconds
    header: 
    tooltip: Seconds a new Owner collects the roster from the other players before
      it decides. Default 1.5.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maximumRecoveryRounds
    header: 
    tooltip: Recovery rounds at recoveryWindowSeconds before the Owner asks at a
      slower pace. Default 3.
    hidden: 0
    space: 0
    hasRange: 1
    rangeMin: 1
    rangeMax: 10
  - symbol: absentSweepSeconds
    header: 
    tooltip: Delay after a player leaves before the Owner removes everyone no longer
      in the instance, in seconds. Default 1.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
