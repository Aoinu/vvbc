  fieldLabels:
  - symbol: match
    header: References
    tooltip: MatchController on this MatchManager object.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: receiver
    header: 
    tooltip: MatchEventReceiver on this MatchManager object (the inbox of accepted
      events).
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: ballQuery
    header: 
    tooltip: 'Ball query (MatchManager/BallQuery): the ball''s accepted states and
      its local flight.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: field
    header: 
    tooltip: The field's fair / foul geometry. Unset = every batted ball goes to
      the umpire.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: changeListeners
    header: 
    tooltip: Behaviours that receive _OnUmpireChanged (review list changes). Panels
      also register themselves.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: engineEnabled
    header: Engine
    tooltip: 'Rule automatically. Off: the engine only watches (no ruling, no review);
      the umpire rules by hand.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: decisionDelaySeconds
    header: Timing (seconds)
    tooltip: Wait after an event's server time before deciding with it, so earlier
      events still on the way can arrive. Default 0.5.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: pendingTimeoutSeconds
    header: 
    tooltip: An open runner decision older than this goes to the umpire. Default
      8.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: pitchResultTimeoutSeconds
    header: 
    tooltip: A manual pitch without the batter's pitch result after this goes to
      the umpire. Default 5.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: hitConfirmSeconds
    header: 
    tooltip: A pitch result reporting bat contact waits this long for the ball's
      accepted hit. Default 2.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: thirdStrikeWaitSeconds
    header: 
    tooltip: A third strike waits this long for the catch or the ground contact of
      the pitch. Default 3.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: catchGroundToleranceSeconds
    header: 
    tooltip: 'Catch and ground contact closer than this cannot be ordered: the umpire
      decides. Default 0.08.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: battedBallTimeoutSeconds
    header: 
    tooltip: A batted ball still undecided after this goes to the umpire. Default
      15.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: trackIntervalSeconds
    header: 
    tooltip: Interval of the batted-ball tracker while fair / foul is open. Default
      0.05.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: contestedMarginSeconds
    header: 
    tooltip: 'Tag or force and a base contact closer than this are contested: the
      umpire decides. Default 0.05.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: thirdOutDeadBallSeconds
    header: 
    tooltip: After the third out, the live period ends this long after the last open
      decision (0 = never; Time is then needed). Default 2.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: eventRetentionSeconds
    header: 
    tooltip: Accepted events are handed back to the receiver this long after their
      time once nothing open needs them. Default 4.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: foulTipMaxSeconds
    header: Batted ball
    tooltip: 'A foul tip: the catcher holds the batted ball within this long after
      the hit. Default 0.3.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: foulTipMaxDistance
    header: 
    tooltip: A foul tip is caught within this distance of home, in metres. Default
      3.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: settleSpeed
    header: 
    tooltip: A ground ball slower than this counts as settling, in m/s. Default 0.5.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: settleSeconds
    header: 
    tooltip: Settling for this long decides fair / foul by where the ball is. Default
      0.6.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: applyTagTimeCorrection
    header: Runners
    tooltip: Correct a tag's time by how late the fielder's client showed the runner
      (SimulationTime), for the decision only; positions are never moved.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: maxTagCorrectionSeconds
    header: 
    tooltip: Largest tag time correction, in seconds. Default 0.5.
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
  - symbol: overrunWindowSeconds
    header: 
    tooltip: 'A batter-runner tagged off first base within this long after leaving
      it may be returning from an overrun: the umpire decides. Default 4.'
    hidden: 0
    space: 0
    hasRange: 0
    rangeMin: 0
    rangeMax: 0
